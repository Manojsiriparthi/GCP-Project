# GCP Project ID
GCP_PROJECT_ID=your-gcp-project-id

# GCP Region
GCP_REGION=us-central1

# Cloud SQL Configuration
DB_HOST=your-cloud-sql-instance-ip
DB_PORT=5432
DB_NAME=bank_app
DB_USER=postgres
DB_PASSWORD=your-secure-password

# Pub/Sub Topics
SEND_EMAIL_TOPIC=send-email
USER_NOTIFICATIONS_TOPIC=user-notifications

# Secret Manager
SECRET_DB_PASSWORD=bank-app-db-password
SECRET_DB_CONNECTION_STRING=bank-app-db-connection-string

# Email Configuration (for notifications)
GMAIL_API_CREDENTIALS=path/to/credentials.json
NOTIFICATION_EMAIL_FROM=noreply@bankapp.com

# Environment
ENVIRONMENT=production
DEBUG=false

# Logging
LOG_LEVEL=INFO
